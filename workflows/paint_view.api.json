{
  "ckpt": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "juggernautXL_v9.safetensors"}},

  "ref_img": {"class_type": "LoadImage", "inputs": {"image": "REF.png"}},
  "ipa_model": {"class_type": "IPAdapterModelLoader", "inputs": {"ipadapter_file": "ip-adapter-plus_sdxl_vit-h.safetensors"}},
  "clip_vision": {"class_type": "CLIPVisionLoader", "inputs": {"clip_name": "CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors"}},
  "ipa": {"class_type": "IPAdapterAdvanced", "inputs": {"model": ["ckpt", 0], "ipadapter": ["ipa_model", 0], "image": ["ref_img", 0], "clip_vision": ["clip_vision", 0], "weight": 0.7, "weight_type": "linear", "combine_embeds": "concat", "start_at": 0.0, "end_at": 1.0, "embeds_scaling": "V only"}},

  "pos": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["ckpt", 1], "text": "PROMPT"}},
  "neg": {"class_type": "CLIPTextEncode", "inputs": {"clip": ["ckpt", 1], "text": "NEGATIVE"}},

  "depth_img": {"class_type": "LoadImage", "inputs": {"image": "DEPTH.png"}},
  "cn_load": {"class_type": "ControlNetLoader", "inputs": {"control_net_name": "controlnet-union-sdxl-promax.safetensors"}},
  "cn_depth": {"class_type": "SetUnionControlNetType", "inputs": {"control_net": ["cn_load", 0], "type": "depth"}},
  "cn_apply": {"class_type": "ControlNetApplyAdvanced", "inputs": {"positive": ["pos", 0], "negative": ["neg", 0], "control_net": ["cn_depth", 0], "image": ["depth_img", 0], "strength": 0.8, "start_percent": 0.0, "end_percent": 1.0, "vae": ["ckpt", 2]}},

  "init_img": {"class_type": "LoadImage", "inputs": {"image": "INIT.png"}},
  "init_latent": {"class_type": "VAEEncode", "inputs": {"pixels": ["init_img", 0], "vae": ["ckpt", 2]}},

  "sample": {"class_type": "KSampler", "inputs": {"model": ["ipa", 0], "positive": ["cn_apply", 0], "negative": ["cn_apply", 1], "latent_image": ["init_latent", 0], "seed": 1, "steps": 30, "cfg": 5.5, "sampler_name": "dpmpp_2m", "scheduler": "karras", "denoise": 0.65}},
  "decode": {"class_type": "VAEDecode", "inputs": {"samples": ["sample", 0], "vae": ["ckpt", 2]}},
  "save": {"class_type": "SaveImage", "inputs": {"images": ["decode", 0], "filename_prefix": "monster-forge/paint"}}
}
