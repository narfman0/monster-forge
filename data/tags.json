{
 "_doc": "Tag taxonomy (definitions shared by every source) plus the SRD's curated tag membership. tools/tags.py merges rules + this file into data/tags.computed.json; docs/tags.md explains groups, rules and how to add a tag or an override. Non-SRD sources keep their own members/ids/no_family in the non-SRD checkout (curation/<source>/tags.json, tools/sources.py).",
 "sources": {
  "srd-5.2.1": "srd"
 },
 "groups": [
  {"id": "source", "label": "source", "rule": "registry `source` via `sources` above", "description": "Which book the stat block comes from."},
  {"id": "type", "label": "creature type", "rule": "registry `type`: type-<type>", "description": "The stat block's creature type, exactly one per monster. Prefixed so `dragon`, `giant` and `elemental` can mean the narrower family."},
  {"id": "family", "label": "family", "rule": "curated `members`, a few id/type rules, `implies`", "description": "Lineage or kind: what the creature is (dragon, devil, canine, golem, npc ...). Every monster has at least one, unless listed in `no_family`."},
  {"id": "dragon-kind", "label": "dragons", "rule": "registry chromatic/metallic tags; colour and age from the id of true dragons", "description": "True dragons by family, colour and age."},
  {"id": "role", "label": "role", "rule": "registry wizard/cleric/druid tags + curated `members`", "description": "What an NPC-style stat block does in a fight or a story."},
  {"id": "trait", "label": "trait", "rule": "curated `members`, taken from the SRD stat blocks (Spellcasting action, Shape-Shift, legendary actions)", "description": "Notable stat-block features."},
  {"id": "movement", "label": "movement", "rule": "registry `speeds` (+ curated adds)", "description": "How it moves, and whether it lives in the water."},
  {"id": "size", "label": "size", "rule": "registry `size`", "description": "Size category, exactly one per monster."},
  {"id": "cr", "label": "challenge", "rule": "registry `cr`", "description": "Challenge rating band, exactly one per monster."},
  {"id": "body-plan", "label": "body plan", "rule": "registry `body_plan` (kebab-case; aquatic -> aquatic-body)", "description": "The pipeline's body plan (docs/body-plans.md), exactly one per monster."},
  {"id": "pipeline", "label": "pipeline", "rule": "out/<source>/<id>/manifest.json, computed by the viewer (and `tags.py compute --pipeline`)", "description": "What the generated asset supports. Not content: depends on the local out/ tree."}
 ],
